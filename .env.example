# Supabase Server-Side Public Configuration
# Add these in Google AI Studio Settings -> Secrets (or local .env)
# NEVER put a service_role or sb_secret_ key in SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# GEMINI_API_KEY: Required if server-side Gemini features are used
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL for the application
APP_URL="MY_APP_URL"
